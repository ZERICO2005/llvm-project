# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-unknown-linux-gnu -passes="print<gisel-value-tracking>" -filetype=null %s 2>&1 | FileCheck %s

# These check that computeKnownBits for G_UITOFP/G_SITOFP retains exponent
# bits of the resulting float's bit pattern, as used by the "convert to
# float to count leading zeros" idiom on SSE2 (128-bit, 4 x s32) and AVX2
# (256-bit, 8 x s32) vector registers.
#
# In UIToFPSSE2/UIToFPAVX2, masking the input to [0, 255] and forcing the
# top bit of that range (so the magnitude is in [128, 255], entirely within
# one binade) means the value always converts exactly (no rounding) to a
# float with biased exponent 134 (0b10000110), so the sign bit and the
# whole exponent field of the result are known, not just its FP class.
#
# In SIToFPSSE2, the same masking instead produces a magnitude range of
# [1, 256], which straddles a power-of-two boundary, so only the sign bit
# (always negative) is known -- this is a regression check that the
# implementation doesn't claim more than it can prove.

---
name:            UIToFPSSE2
body:             |
  bb.1:
  ; CHECK-LABEL: name: @UIToFPSSE2
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %mask:_ KnownBits:00000000000000000000000011111111 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %maskvec:_ KnownBits:00000000000000000000000011111111 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %and:_ KnownBits:000000000000000000000000???????? SignBits:24 IsKnownNeverZero:0
  ; CHECK-NEXT: %bit:_ KnownBits:00000000000000000000000010000000 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %bitvec:_ KnownBits:00000000000000000000000010000000 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %or:_ KnownBits:0000000000000000000000001??????? SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %f:_ KnownBits:010000110??????????????????????? SignBits:1 IsKnownNeverZero:1
    %0:_(<4 x s32>) = COPY $xmm0
    %mask:_(s32) = G_CONSTANT i32 255
    %maskvec:_(<4 x s32>) = G_BUILD_VECTOR %mask, %mask, %mask, %mask
    %and:_(<4 x s32>) = G_AND %0, %maskvec
    %bit:_(s32) = G_CONSTANT i32 128
    %bitvec:_(<4 x s32>) = G_BUILD_VECTOR %bit, %bit, %bit, %bit
    %or:_(<4 x s32>) = G_OR %and, %bitvec
    %f:_(<4 x s32>) = G_UITOFP %or
...
---
name:            SIToFPSSE2
body:             |
  bb.1:
  ; CHECK-LABEL: name: @SIToFPSSE2
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %mask:_ KnownBits:00000000000000000000000011111111 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %maskvec:_ KnownBits:00000000000000000000000011111111 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %and:_ KnownBits:000000000000000000000000???????? SignBits:24 IsKnownNeverZero:0
  ; CHECK-NEXT: %bit:_ KnownBits:11111111111111111111111100000000 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %bitvec:_ KnownBits:11111111111111111111111100000000 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %neg:_ KnownBits:111111111111111111111111???????? SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %f:_ KnownBits:1??????????????????????????????? SignBits:1 IsKnownNeverZero:1
    %0:_(<4 x s32>) = COPY $xmm0
    %mask:_(s32) = G_CONSTANT i32 255
    %maskvec:_(<4 x s32>) = G_BUILD_VECTOR %mask, %mask, %mask, %mask
    %and:_(<4 x s32>) = G_AND %0, %maskvec
    %bit:_(s32) = G_CONSTANT i32 -256
    %bitvec:_(<4 x s32>) = G_BUILD_VECTOR %bit, %bit, %bit, %bit
    %neg:_(<4 x s32>) = G_OR %and, %bitvec
    %f:_(<4 x s32>) = G_SITOFP %neg
...
---
name:            UIToFPAVX2
body:             |
  bb.1:
  ; CHECK-LABEL: name: @UIToFPAVX2
  ; CHECK-NEXT: %0:_ KnownBits:???????????????????????????????? SignBits:1 IsKnownNeverZero:0
  ; CHECK-NEXT: %mask:_ KnownBits:00000000000000000000000011111111 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %maskvec:_ KnownBits:00000000000000000000000011111111 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %and:_ KnownBits:000000000000000000000000???????? SignBits:24 IsKnownNeverZero:0
  ; CHECK-NEXT: %bit:_ KnownBits:00000000000000000000000010000000 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %bitvec:_ KnownBits:00000000000000000000000010000000 SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %or:_ KnownBits:0000000000000000000000001??????? SignBits:24 IsKnownNeverZero:1
  ; CHECK-NEXT: %f:_ KnownBits:010000110??????????????????????? SignBits:1 IsKnownNeverZero:1
    %0:_(<8 x s32>) = COPY $ymm0
    %mask:_(s32) = G_CONSTANT i32 255
    %maskvec:_(<8 x s32>) = G_BUILD_VECTOR %mask, %mask, %mask, %mask, %mask, %mask, %mask, %mask
    %and:_(<8 x s32>) = G_AND %0, %maskvec
    %bit:_(s32) = G_CONSTANT i32 128
    %bitvec:_(<8 x s32>) = G_BUILD_VECTOR %bit, %bit, %bit, %bit, %bit, %bit, %bit, %bit
    %or:_(<8 x s32>) = G_OR %and, %bitvec
    %f:_(<8 x s32>) = G_UITOFP %or
...
